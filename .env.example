# Copy this file to .env and set unique secret values before running SATYA.
SECRET_KEY=replace-with-a-long-random-secret
SATYA_ENV=development

# MySQL through XAMPP (default XAMPP root account has no password on localhost:3306)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/satya_db

# Alternative discrete MySQL settings (used only if DATABASE_URL is left empty)
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=satya_db

# MySQL connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# SQLite fallback option (for isolated local testing without MySQL)
# DATABASE_URL=sqlite:///satya.sqlite

UPLOAD_FOLDER=uploads
MAX_UPLOAD_BYTES=16777216
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12

AI_PROVIDER=none
AI_API_KEY=
AI_API_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
